{
  "version": 1,
  "algorithms": {
    "lzss": {
      "search_size": 4095,
      "lookahead_size": 31,
      "min_match": 0,
      "use_flag_encoding": 1
    },
    "lzdp": {
      "search_size": 4095,
      "lookahead_size": 31,
      "min_match": 0,
      "dp_top": 6,
      "match_engine": 1,
      "use_flag_encoding": 1
    },
    "dpflate": {
      "search_size": 32767,
      "lookahead_size": 255,
      "min_match": 0,
      "dp_sub_match_max": 6,
      "max_chain_length": 256,
      "match_engine": 1,
      "use_flag_encoding": 1,
      "use_3hfmtree": 0,
      "huffman_offset_chunk_bits": 8,
      "huffman_length_chunk_bits": 8
    },
    "deflate": {
      "search_size": 32767,
      "lookahead_size": 255,
      "min_match": 0,
