      "min_file_size_bytes": 1024,
      "max_file_size_for_l2": 104857600,
      "warmup_samples": 50,
      "ucb_gap_threshold": 0.05,
      "l1_min_samples": 3,
      "l2_min_samples": 5
    }
  },
  "compression": {
    "use_web_resource_dict": false
