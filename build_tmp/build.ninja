  FLAGS = -O3 -DNDEBUG
  INCLUDES = -ID:/AAA_C/compression-tool/build_tmp/_deps/google_brotli-src/c/include
  OBJECT_DIR = _deps\google_brotli-build\CMakeFiles\brotli.dir
  OBJECT_FILE_DIR = _deps\google_brotli-build\CMakeFiles\brotli.dir\c\tools


