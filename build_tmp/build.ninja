build _deps/google_brotli-build/CMakeFiles/brotli.dir/c/tools/brotli.c.obj: C_COMPILER__brotli_unscanned_Release D$:/AAA_C/compression-tool/build_tmp/_deps/google_brotli-src/c/tools/brotli.c || cmake_object_order_depends_target_brotli
