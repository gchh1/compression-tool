  restat = $RESTAT


#############################################
# Rule for re-running cmake.

rule RERUN_CMAKE
  command = D:\AAA_C\AAA_MinGW\mingw64\bin\cmake.exe --regenerate-during-build -SD:\AAA_C\compression-tool -BD:\AAA_C\compression-tool\build_tmp
  description = Re-running CMake...
  generator = 1


#############################################
# Rule for cleaning all built files.

rule CLEAN
  command = D:\AAA_C\AAA_MinGW\mingw64\bin\ninja.exe $FILE_ARG -t clean $TARGETS
  description = Cleaning all built files...


#############################################
# Rule for printing all primary targets available.

rule HELP
  command = D:\AAA_C\AAA_MinGW\mingw64\bin\ninja.exe -t targets
  description = All primary targets available:

